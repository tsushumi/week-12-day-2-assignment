PORT=3000

# Upstash Redis connection string (the rediss:// TLS URL from the Upstash console).
# While this is still the placeholder (or missing), the app uses REDIS_URL below,
# or a local Redis at redis://127.0.0.1:6379.
UPSTASH_REDIS_URL=rediss://default:your-password-here@your-endpoint.upstash.io:6379

# Optional: local Redis for development without Upstash
# REDIS_URL=redis://127.0.0.1:6379

# Optional: base URL used in "your PDF is ready" download links (default http://localhost:PORT)
# PUBLIC_BASE_URL=http://localhost:3000

# Optional: where generated PDFs are written (default ./invoices)
# INVOICES_DIR=./invoices
