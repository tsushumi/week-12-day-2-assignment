{
  "name": "week-12-day-2-assignment",
  "version": "1.0.0",
  "description": "Background jobs with BullMQ: email queue, retries with backoff, PDF generation, priorities",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=90000 \"test/*.test.js\"",
    "dev": "nodemon src/server.js",
    "workers": "node src/worker.js",
    "dev:all": "concurrently -n api,worker -c cyan,magenta \"npm run dev\" \"npm run workers\"",
    "start": "node src/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^6.5.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.6": true
  }
}
